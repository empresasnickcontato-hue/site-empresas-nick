# Copie para .env (local) e configure as MESMAS vars no Render (backend).
# ATENÇÃO: JWT_SECRET precisa ser IDÊNTICO em todo deploy — se mudar,
# todos os tokens antigos dão 401 e o /admin mostra zeros.

# Auth (obrigatório — mesmo valor em todos os ambientes)
JWT_SECRET=nick_secret_2024

# Servidor
PORT=3001

# Persistência Turso (obrigatório em produção — Render tem disco efêmero;
# sem isso os JSON zeram a cada restart e o /admin mostra 0 usuários)
TURSO_DATABASE_URL=libsql://seu-banco.turso.io
TURSO_AUTH_TOKEN=seu_token_do_turso

# URL pública do frontend (usada nos links de reset de senha)
FRONTEND_URL=http://localhost:5173

# WhatsApp / Pix
OWNER_PHONE=5511916572015
PIX_CHAVE=11916572015
PIX_NOME=EMPRESAS NICK
PIX_CIDADE=SAO PAULO

# Email via Gmail SMTP (nodemailer) — opcional (sem isso, reset de senha só gera link dev)
# EMAIL_USER=seu@gmail.com
# EMAIL_PASS=senha_de_app_do_gmail_com_16_caracteres
